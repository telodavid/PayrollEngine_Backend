###
POST {{PayrollEngine_HostAddress}}/api/reports
Content-Type: application/json

{
  "reportCode": "PAYROLL_ELEMENT_PER_EMPLOYEE",
  "name": "Bérelemek dolgozónként",
  "version": 1,
  "isActive": true,
  "dataSource": "PAYROLL_RESULT",
  "xmlRootElementName": "PayrollExport",
  "xmlRecordElementName": "Employee",
  "fileNamePattern": "payroll_{period}_{employeeId}",
  "fields": [
    {
      "code": "employeeId",
      "displayName": "Dolgozóazonosító",
      "outputName": "EmployeeId",
      "value": {
        "kind": "REFERENCE",
        "reference": "dbo.PayrollResult.EmployeeId"
      },
      "aggregation": "NONE"
    },
    {
      "code": "period",
      "displayName": "Periódus",
      "outputName": "Period",
      "value": {
        "kind": "REFERENCE",
        "reference": "dbo.PayrollResult.Period"
      },
      "aggregation": "NONE"
    },
    {
      "code": "payrollElement",
      "displayName": "Bérelemkód",
      "outputName": "PayrollElement",
      "value": {
        "kind": "REFERENCE",
        "reference": "dbo.PayrollElement.Code"
      },
      "aggregation": "NONE"
    },
    {
      "code": "amount",
      "displayName": "Összeg",
      "outputName": "Amount",
      "value": {
        "kind": "REFERENCE",
        "reference": "dbo.PayrollResult.Amount"
      },
      "aggregation": "SUM",
      "format": "0.00"
    },
    {
      "code": "exportType",
      "displayName": "Kimeneti típus",
      "outputName": "ExportType",
      "value": {
        "kind": "CONSTANT",
        "constant": "PAYROLL"
      },
      "aggregation": "NONE"
    }
  ],
  "grouping": {
    "rowMode": "GROUPED",
    "groupBy": [
      "dbo.PayrollResult.EmployeeId",
      "dbo.PayrollResult.Period",
      "dbo.PayrollElement.Code"
    ],
    "splitFilesBy": [
      "dbo.PayrollResult.Period",
      "dbo.PayrollResult.EmployeeId"
    ],
    "sortBy": [
      "dbo.PayrollResult.EmployeeId",
      "dbo.PayrollElement.Code"
    ]
  }
}
