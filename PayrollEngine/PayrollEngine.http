Content-Type: application/json

{
  "ruleCode": "DYNAMIC_FIELD_VALID_REF_TEST"
  "name": "Hibás dinamikus hivatkozás teszt",
  "version": 1,
  "isActive": true,
  "steps": [
    {
      "code": "if",
      "inputs": {
        "condition": {
          "code": "equal",
          "inputs": {
            "left": {
              "code": "dataReference",
              "inputs": {
                "reference": "PAYROLL_ELEMENT.PAYROLL_TEST.BONUS_CATEGORY"
              }
            },
            "right": {
              "code": "constant",
              "inputs": {
                "valueType": "text",
                "value": "PERFORMANCE"
              }
            }
          }
        },
        "thenSteps": []
      }
    }
  ]
}
